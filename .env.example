# CreditCoin Testnet Configuration (Optional - defaults provided)
NEXT_PUBLIC_CREDITCOIN_TESTNET_RPC=https://rpc.cc3-testnet.creditcoin.network
NEXT_PUBLIC_CREDITCOIN_TESTNET_CHAIN_ID=102031
NEXT_PUBLIC_CREDITCOIN_TESTNET_EXPLORER=https://creditcoin-testnet.blockscout.com
NEXT_PUBLIC_CREDITCOIN_TESTNET_CURRENCY=CTC
NEXT_PUBLIC_CREDITCOIN_TESTNET_CURRENCY_SYMBOL=CTC
NEXT_PUBLIC_CREDITCOIN_TESTNET_CURRENCY_DECIMALS=18

# CreditCoin Treasury (Required - replace with your values)
CREDITCOIN_TREASURY_ADDRESS=your_treasury_address_here
CREDITCOIN_TREASURY_PRIVATE_KEY=your_treasury_private_key_here
NEXT_PUBLIC_CREDITCOIN_TREASURY_ADDRESS=your_treasury_address_here

# Supabase Configuration (Required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Prefer publishable key (sb_publishable_...) or legacy anon JWT
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key_here
# Prefer secret key (sb_secret_...) or legacy service_role JWT — server only
SUPABASE_SERVICE_ROLE_KEY=your_supabase_secret_or_service_role_key_here

# Market price providers (replaces expired Pyth Hermes feeds)
# Order: first successful provider wins
PRICE_PROVIDER_ORDER=coingecko,dexscreener,cmc,gmgn,axiom,padre
NEXT_PUBLIC_PRICE_PROVIDER_ORDER=coingecko,dexscreener,cmc,gmgn,axiom,padre
PRICE_POLL_INTERVAL_MS=2000

# CoinGecko (primary — free demo key optional)
COINGECKO_API_BASE=https://api.coingecko.com/api/v3
# COINGECKO_API_KEY=
# COINGECKO_DEMO_API_KEY=

# DexScreener (public, no key)
DEXSCREENER_API_BASE=https://api.dexscreener.com

# CoinMarketCap (optional — requires API key)
CMC_API_BASE=https://pro-api.coinmarketcap.com
# CMC_API_KEY=
# COINMARKETCAP_API_KEY=

# GMGN (optional — set per-asset token mint/contract to enable)
GMGN_API_BASE=https://gmgn.ai
GMGN_CHAIN=sol
# GMGN_TOKEN_SOL=
# GMGN_TOKEN_BTC=

# Axiom / Padre terminals (optional custom price APIs)
# AXIOM_API_BASE=https://your-axiom-proxy.example
# AXIOM_API_KEY=
# AXIOM_PRICE_PATH=/api/price/{symbol}
# PADRE_API_BASE=https://your-padre-proxy.example
# PADRE_API_KEY=
# PADRE_PRICE_PATH=/api/price/{symbol}

# WalletConnect (Optional - for wallet connection)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id_here

# Privy (Optional - for social login)
NEXT_PUBLIC_PRIVY_APP_ID=your_privy_app_id_here
PRIVY_APP_SECRET=your_privy_app_secret_here

# Application Configuration (Optional - defaults provided)
NEXT_PUBLIC_APP_NAME=CreditNomo
NEXT_PUBLIC_CTC_NETWORK=testnet
NEXT_PUBLIC_ROUND_DURATION=30

# Attestcoin Protocol (BUIDL CTC 2026 Fall — required for cross-chain deposits)
# Docs: https://docs.attestcoin.org/
ATTESTCOIN_PROOF_BUILDER_URL=https://proof-gen-api.cc3-testnet.creditcoin.network
NEXT_PUBLIC_ATTESTCOIN_PROOF_BUILDER_URL=https://proof-gen-api.cc3-testnet.creditcoin.network
NEXT_PUBLIC_ATTESTCOIN_DASHBOARD_URL=https://dashboard.cc3-testnet.creditcoin.network
NEXT_PUBLIC_ATTESTCOIN_DECODER_ADDRESS=0x731c345d79Fb8BbDC541f9DF3b6317585F849F9f
NEXT_PUBLIC_ATTESTCOIN_SEPOLIA_CHAIN_KEY=1
# Sepolia address that receives ETH for attested deposits (can be same EOA as treasury)
NEXT_PUBLIC_SEPOLIA_DEPOSIT_ADDRESS=your_sepolia_deposit_address_here
# Public Sepolia RPC (or Infura/Alchemy)
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Testnet house-balance credit: 1 ETH on Sepolia → N CTC
ATTESTCOIN_ETH_TO_CTC_RATE=1000
# Max wait for Attestcoin block attestation before returning "retry" (ms)
ATTESTCOIN_ATTESTATION_WAIT_MS=120000

